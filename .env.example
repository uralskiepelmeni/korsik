# токен бота MAX (выдаёт @MasterBot при создании бота)
MAX_TOKEN=

# адрес сервиса ответов (по умолчанию локальный)
KORSIK_API=http://127.0.0.1:8000

# код для команды /bootstrap — по нему любой может выдать себе роль администратора
KORSIK_PANEL_TOKEN=change-me

# путь к своему набору корневых сертификатов (нужно, если запускаете за прокси,
# который не доверяет российскому корневому сертификату)
# MAX_CA=/etc/ssl/certs/ca-certificates.crt

# модель эмбеддингов и модель-верификатор
KORSIK_EMB_MODEL=BAAI/bge-m3
KORSIK_VERIFIER=vllm-sr/d3-nano

# устройство: cuda или cpu (по умолчанию определяется автоматически)
# KORSIK_DEVICE=cuda

# демо-режим календаря адаптации: 1 = одна минута равна одному дню
KORSIK_DEMO=0

# сервис
KORSIK_HOST=0.0.0.0
KORSIK_PORT=8000
# KORSIK_DB=./data/korsik.db
